{
  "$defs": {
    "PackageIndexEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 200,
          "title": "Description",
          "type": "string"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "latest": {
          "title": "Latest",
          "type": "string"
        },
        "manifest": {
          "title": "Manifest",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "publisher",
        "latest",
        "manifest"
      ],
      "title": "PackageIndexEntry",
      "type": "object"
    },
    "PublisherIndexEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "manifest": {
          "title": "Manifest",
          "type": "string"
        }
      },
      "required": [
        "id",
        "manifest"
      ],
      "title": "PublisherIndexEntry",
      "type": "object"
    },
    "SchemaIndexEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "title": "SchemaIndexEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "kori.marketplace.index.v1",
      "default": "kori.marketplace.index.v1",
      "title": "Schema",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "trust": {
      "default": "packages/trust.json",
      "title": "Trust",
      "type": "string"
    },
    "schemas": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SchemaIndexEntry"
      },
      "title": "Schemas",
      "type": "array"
    },
    "publishers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PublisherIndexEntry"
      },
      "title": "Publishers",
      "type": "array"
    },
    "packages": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PackageIndexEntry"
      },
      "title": "Packages",
      "type": "array"
    }
  },
  "required": [
    "generated_at"
  ],
  "title": "MarketplaceIndex",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kkori.xyz/schema/v1/index.json"
}
